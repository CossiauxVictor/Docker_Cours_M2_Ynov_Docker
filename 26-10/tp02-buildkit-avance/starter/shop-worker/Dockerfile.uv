# syntax=docker/dockerfile:1.10
# Bonus B3 : meme Dockerfile mais avec uv a la place de pip.
# Attention : uv lit PAS pip.conf -> l'index prive passe en secret sous forme de variable d'env
# (secret "env=" dispo a partir du frontend dockerfile 1.10) :
#   UV_INDEX_URL=https://pypi.org/simple docker build -f Dockerfile.uv --secret id=uv_index_url,env=UV_INDEX_URL -t worker:uv .

FROM python:3.12.15-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
WORKDIR /app

FROM base AS builder
ARG TARGETARCH
# binaire uv statique copie depuis l'image officielle (version epinglee)
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
# le cache mount est sur un autre filesystem que /opt/venv : uv peut pas faire de hardlink -> copy
ENV UV_LINK_MODE=copy
RUN uv venv /opt/venv
COPY requirements.txt ./
RUN --mount=type=secret,id=uv_index_url,env=UV_INDEX_URL,required=true \
    --mount=type=cache,target=/root/.cache/uv,id=uv-${TARGETARCH},sharing=locked \
    uv pip install --python /opt/venv/bin/python -r requirements.txt

FROM builder AS test
ARG TARGETARCH
COPY requirements-dev.txt ./
RUN --mount=type=secret,id=uv_index_url,env=UV_INDEX_URL,required=true \
    --mount=type=cache,target=/root/.cache/uv,id=uv-${TARGETARCH},sharing=locked \
    uv pip install --python /opt/venv/bin/python -r requirements-dev.txt
COPY worker ./worker
COPY tests ./tests
RUN ruff check worker tests \
 && python -m pytest -q -p no:cacheprovider tests

FROM base AS runtime
RUN groupadd --system --gid 10001 worker \
 && useradd --system --uid 10001 --gid worker --no-create-home --shell /usr/sbin/nologin worker
COPY --from=builder /opt/venv /opt/venv
COPY --from=test /app/worker ./worker
USER 10001:10001
CMD ["python", "-m", "worker.main"]
